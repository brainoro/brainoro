# Brainoro Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Identity Services (GIS) Client ID
# Obtain from Google Cloud Console > Credentials > OAuth 2.0 Client IDs (Web application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Feature Flag: Set to 'true' to restore the legacy OAuth redirect flow (supabase.co redirect)
NEXT_PUBLIC_USE_OAUTH_REDIRECT=false
